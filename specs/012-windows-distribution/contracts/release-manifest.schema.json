{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:manga-to-kindle:contracts:release-manifest:1.0",
  "title": "Manga to Kindle Release Manifest",
  "description": "Entradas normalizadas, composição e saídas planejadas de uma distribuição Windows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "source",
    "toolchain",
    "target_pairs",
    "bundle",
    "components",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)([-][0-9A-Za-z.-]+)?([+][0-9A-Za-z.-]+)?$"
        },
        "description": {"type": "string"},
        "publisher": {"type": ["string", "null"]},
        "copyright": {"type": ["string", "null"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_id", "uv_lock_sha256", "pyinstaller_spec_sha256"],
      "properties": {
        "commit_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "uv_lock_sha256": {"$ref": "#/$defs/sha256"},
        "pyinstaller_spec_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "uv",
        "pyinstaller",
        "windows_build_image"
      ],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "uv": {"type": "string", "minLength": 1},
        "pyinstaller": {"type": "string", "minLength": 1},
        "windows_build_image": {"type": "string", "minLength": 1}
      }
    },
    "target_pairs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/targetPair"}
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "pyinstaller_mode"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["portable-archive", "inno-installer"]
        },
        "pyinstaller_mode": {"type": "string", "const": "onedir"},
        "installer_version": {"type": ["string", "null"]}
      }
    },
    "components": {
      "type": "array",
      "items": {"$ref": "#/$defs/packagedComponent"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifactReference"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targetPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows", "architecture"],
      "properties": {
        "windows": {
          "type": "string",
          "enum": ["Windows 10", "Windows 11"]
        },
        "architecture": {
          "type": "string",
          "enum": ["x64", "ARM64", "x86"]
        }
      }
    },
    "packagedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "category",
        "source_url",
        "license_id",
        "notice_path"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "category": {
          "type": "string",
          "enum": [
            "runtime",
            "python-package",
            "qt-plugin",
            "resource",
            "native-library"
          ]
        },
        "source_url": {"type": "string", "format": "uri"},
        "license_id": {"type": "string", "minLength": 1},
        "copyright": {"type": ["string", "null"]},
        "notice_path": {"type": ["string", "null"]},
        "included": {"type": "boolean", "const": true}
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "format", "target_pair"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "format": {
          "type": "string",
          "enum": ["portable-archive", "inno-installer"]
        },
        "target_pair": {"$ref": "#/$defs/targetPair"}
      }
    }
  }
}
